SECRET_KEY=your_flask_secret_key
SQLALCHEMY_DATABASE_URI=postgresql://user:password@hostname:5432/dbname

# Google Drive – konto serwisowe
# Wklej cały JSON jako jedną linię (bez znaków nowej linii) lub
# podaj ścieżkę do pliku JSON w GOOGLE_SERVICE_ACCOUNT_FILE
GOOGLE_SERVICE_ACCOUNT_JSON={...json‑treść…}
# (opcjonalnie) GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# APScheduler (czas lokalny) – Render ustawia PORT automatycznie
APScheduler_TIMEZONE=Europe/Warsaw

# (opcjonalnie) nazwa hosta w Renderze, przy generowaniu pełnych URL‑i
RENDER_EXTERNAL_HOSTNAME=your‑app.onrender.com